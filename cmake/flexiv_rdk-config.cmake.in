include(CMakeFindDependencyMacro)

# Find dependency.
# Eigen3 + Threads are always required: Eigen is header-only and leaks through
# the public flexiv::rdk API, so it must stay ABI-compatible with the version
# the library was built against.
set(THREADS_PREFER_PTHREAD_FLAG ON)
find_dependency(Threads REQUIRED)
find_dependency(Eigen3 3.4.0 REQUIRED)

# For the self-contained shared-library packaging (Linux/macOS), all remaining
# dependencies are statically embedded and symbol-hidden inside the RDK, so
# consumers neither find nor link them. They are only required for the static
# packaging (Windows/QNX).
if(NOT @RDK_SELF_CONTAINED@)
  set(Boost_USE_STATIC_LIBS OFF)
  find_dependency(spdlog 1.9.2 REQUIRED)
  find_dependency(zenohc 1.9.0 REQUIRED)
  find_dependency(zenohcxx 1.9.0 REQUIRED)
  find_dependency(RBDyn 1.9.3 REQUIRED)
endif()

# Add targets file
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@-targets.cmake")
